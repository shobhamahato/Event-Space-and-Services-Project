.wstooltip .wstooltiptext {
    visibility: hidden;
    width: 100%;
    /* min-width: 600px; */
    background-color: #f7742e;
    color: #fff;
    text-align: center !important;
    border-top-left-radius: 3px !important;
    border-radius: 6px;
    padding: 10px;
    position: absolute;
    z-index: 1;
    top: 30px;
}

.wstooltip:hover .wstooltiptext {
  visibility: visible;
	display:block;
}
.vendor-loc-wrap{
	    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
	    word-break: break-all;
}
.wstooltip .wstooltiptext:after {
    content: "";
    display: block;
    position: absolute;
    border-color: #f7742e rgba(0, 0, 0, 0);
    border-style: solid;
    border-width: 12px 10px 0;
    bottom: 58px;
    left: -10px;
    transform: translate(-50%, 0);
    width: 0;
    rotate: 180deg;
}
