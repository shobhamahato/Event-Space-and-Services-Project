    margin-top: 25px;
}

.sib-signup-new .sib-field-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 70%;
    margin: 0 auto 15px;
		padding: 0 !important;
}

.sib-signup-new .sib-field-area label {
    display: block;
    width: 100%;
    text-align: left;
    font-size: 15px;
