    border: 1px solid #ccc;
    padding: 6px 12px;
    transition: all .3s ease-in-out;
}

.sib-signup-new .sib-submit-btn {
    display: inline-block;
    background: #519C28;
    border: none;
    color: #fff;
    font-size: 15px;
    padding: 15px 40px 15px 40px;
    margin-top: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
		border-radius: 30px;
}

@media(max-width: 540px) {
    .sib-signup-new .sib-field-area label {
        font-size: 13px;
    }

